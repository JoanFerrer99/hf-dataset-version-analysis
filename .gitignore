# ============================================================
# Python
# ============================================================
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.Python
 
# ============================================================
# Environments — NEVER commit these (contain secrets)
# ============================================================
.env
.envrc
.venv
venv/
env/
ENV/
 
# ============================================================
# TFG project — runtime outputs (large files, not for git)
# ============================================================
# Raw data outputs from the pipeline
data/raw/
data/processed/
 
# Full-scan outputs (can be hundreds of MB)
data/full_scan_checkpoint.txt
data/full_scan_eligible.csv
data/full_scan_stats.json
data/eligibility_report_*.csv
data/funnel_summary_*.json
 
# Keep the data/ folder itself in git (via .gitkeep)
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
 
